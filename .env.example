# VitaCall Environment Configuration (Copy to .env for production)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Generate 64-char hex keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITACALL_JWT_SECRET=
VITACALL_ENCRYPTION_KEY=
VITACALL_HMAC_KEY=

# Firebase Admin SDK (default OFF; set FIREBASE_SYNC_ENABLED=true only after DPA compliance & consent)
FIREBASE_SYNC_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time Production Admin Bootstrap (used only on first production start when 0 admins exist)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME="Clinic Director"

# Optional SMTP configuration for Forgot Password emails (if unset, falls back to Clinic Reset Ticket)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VitaCall USTP Clinic <no-reply@ustp.edu.ph>"

