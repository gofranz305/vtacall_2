rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny-all client access by default:
    // VitaCall's Node/Express backend uses the Firebase Admin SDK (which bypasses security rules)
    // to sync allowlisted, AES-256-GCM encrypted records when FIREBASE_SYNC_ENABLED=true.
    // Relax these rules ONLY if a browser/mobile client SDK with verified custom role claims is introduced.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
